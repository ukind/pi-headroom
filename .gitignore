# Dev-only harness: npm install (Slice 4) creates extensions/headroom/node_modules/.
# Ignore it at any depth so the harness commit stages manifests, not dependencies.
node_modules/

# The Python falsification suite (moved to test/ in Slice 6) compiles to
# test/__pycache__/ on every run - ignore it at any depth.
__pycache__/

# pi + rpiv local state (never part of the extension)
.pi/
.rpiv/
